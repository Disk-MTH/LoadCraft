{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "make build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "make test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "flash",
      "type": "shell",
      "command": "make flash PORT=${input:serialPort}",
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make clean"
    },
    {
      "label": "build: firmware tests",
      "type": "shell",
      "command": "make -C tests",
      "problemMatcher": ["$gcc"]
    }
  ],
  "inputs": [
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "Serial port of the board",
      "default": "/dev/ttyACM0"
    }
  ]
}
