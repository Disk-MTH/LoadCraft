{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "app: launch",
      "type": "debugpy",
      "request": "launch",
      "module": "loadcraft",
      "cwd": "${workspaceFolder}/app",
      "console": "integratedTerminal"
    },
    {
      "name": "app: pytest current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}/app",
      "console": "integratedTerminal"
    },
    {
      "name": "firmware tests: gdb",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/tests/build/test_${input:firmwareTest}",
      "cwd": "${workspaceFolder}/tests",
      "MIMode": "gdb",
      "preLaunchTask": "build: firmware tests",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ],
  "inputs": [
    {
      "id": "firmwareTest",
      "type": "pickString",
      "description": "Test binary",
      "options": ["hb_core", "hb_protocol", "hb_record"],
      "default": 0
    }
  ]
}
