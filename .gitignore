# Build artifacts
build/
*.o
*.elf
*.hex
*.bin
firmware/handbrake/version.h
app/*.spec

# Generated app data (populated by `make build-hex` / `make package-*`)
app/loadcraft/_version.py
app/loadcraft/data/
dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Arduino / PlatformIO
.pio/

# VS Code: the shared configuration is versioned; only per-machine
# files are ignored.
.vscode/*.log
.vscode/ipch/
.vscode/*.local.json

# Editors / OS
*.swp
.DS_Store

# Claude Code plugin state
.remember/
